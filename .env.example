# Kopier til .env.local for lokal utvikling. Aldri commit ekte verdier —
# se INFRASTRUCTURE.md 9.

# Postgres (Neon i Stadium 0, se INFRASTRUCTURE.md 16 — Aiven i Stadium 1)
DATABASE_URL=postgres://user:password@localhost:5432/kildebanken

# Brevo (SPEC-V1.md / INFRASTRUCTURE.md 6.2 — besluttet)
BREVO_API_KEY=
BREVO_SENDER_TRANSACTIONAL=varsler@tjenesten.no
BREVO_SENDER_BULK=utsendelse@epost.tjenesten.no

# Sesjoner / magic link (SPEC-V1.md 6)
AUTH_TOKEN_SECRET=

# Sentry (INFRASTRUCTURE.md 3, EU-region)
SENTRY_DSN=

# Plattformens standardspråk — terminal fallback, se SPEC-V1.md 26.1 punkt 2.
# Endres IKKE per miljø; dette er en produktbeslutning, ikke konfigurasjon.
NEXT_PUBLIC_PLATFORM_DEFAULT_LOCALE=nb-NO

# Brukes i digest-e-postens lenker (src/lib/email/digest.ts). Sett til det
# faktiske domenet i produksjon/test.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Retensjonsjobben (SPEC-V1.md 17.4, src/lib/jobs/retention.ts) kjører som
# "dry run" med mindre denne er EKSPLISITT satt til "false". Sett den ALDRI
# til "false" mot et miljø med ekte personopplysninger uten at noen faktisk
# har verifisert dry run-loggene først.
RETENTION_DRY_RUN=true
